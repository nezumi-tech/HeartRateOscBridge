<Window x:Class="HeartRateAntPlus.HeartRateGraphWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="心拍数グラフ" Width="760" Height="480" MinWidth="560" MinHeight="360" Background="#101216">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="心拍数の時間変化" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
    <Canvas x:Name="ChartCanvas" Grid.Row="1" Background="#15181E" Margin="0,18,0,12" SizeChanged="ChartSizeChanged"/>
    <TextBlock x:Name="ChartStatus" Grid.Row="2" Text="心拍データを受信するとグラフが表示されます。" Foreground="#AAB0BC" FontSize="12"/>
  </Grid>
</Window>
