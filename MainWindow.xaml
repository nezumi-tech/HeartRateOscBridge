<Window x:Class="HeartRateAntPlus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HeartRate OSC Bridge" Icon="Assets/HeartRateOscBridge.png" Width="620" Height="660" MinWidth="600" MinHeight="620" Background="#101216">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1. タイトル / 接続状態 -->
    <DockPanel Grid.Row="0">
      <TextBlock Text="HeartRate OSC Bridge" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" Text="未接続" Foreground="#AAB0BC" FontSize="14" Margin="18,8,0,0"/>
    </DockPanel>

    <!-- 2. 心拍センサ名 -->
    <TextBlock Grid.Row="1" x:Name="SensorText" Text="心拍センサ: 未検出" Foreground="#AAB0BC" HorizontalAlignment="Center" Margin="0,28,0,0"/>

    <!-- 3. 現在の心拍数 -->
    <TextBlock Grid.Row="2" Text="現在の心拍数" Foreground="#AAB0BC" HorizontalAlignment="Center" FontSize="16" Margin="0,28,0,0"/>

    <!-- 4. XX BPM -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
      <TextBlock x:Name="BpmText" Text="--" Foreground="White" FontSize="82" FontWeight="Bold"/>
      <TextBlock Text=" BPM" Foreground="#AAB0BC" FontSize="20" VerticalAlignment="Bottom" Margin="8,0,0,20"/>
    </StackPanel>

    <!-- 5. 集計 -->
    <Grid Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="接続後の集計" Foreground="#AAB0B0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SessionStatsText" Text="最大 --  最小 --  平均 --" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Text="過去5分の集計" Foreground="#AAB0B0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="RecentStatsText" Text="最大 --  最小 --  平均 --" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>

    <!-- 6. 集計をリセット -->
    <Button Grid.Row="5" Content="集計をリセット" Width="130" Height="30" HorizontalAlignment="Center" Click="ResetStatsClick" Margin="0,20,0,0"/>

    <!-- 7. 接続 / 設定 -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
      <Button x:Name="ConnectButton" Content="接続" Width="110" Height="38" Click="ConnectClick" Margin="0,0,8,0"/>
      <Button Content="設定" Width="80" Height="38" Click="SettingsClick" Margin="0,0,8,0"/>
      <Button Content="心拍グラフ" Width="110" Height="38" Click="GraphClick"/>
    </StackPanel>

    <!-- 8. OSC送信 -->
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <TextBlock x:Name="OscStatusText" Text="OSC: OFF" Foreground="#AAB0BC" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button x:Name="OscToggleButton" Content="OSC ON" Width="82" Height="30" Click="OscToggleClick"/>
    </StackPanel>

    <!-- 9. 余白 -->
    <Border Grid.Row="8"/>

    <!-- 10. ステータス -->
    <TextBlock Grid.Row="9" x:Name="FooterText" Foreground="#737A87" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"/>
  </Grid>
</Window>
